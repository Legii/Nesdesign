<Page
    x:Class="Nesdesign.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Nesdesign"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Klienci"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="AliceBlue">
        <StackPanel>
            <Label
                Margin="0,0,0,8"
                Content="Klienci"
                FontSize="16"
                FontWeight="Bold" />
            <DataGrid
                x:Name="ClientsDataView"
                AutoGenerateColumns="False"
                CanUserAddRows="True"
                CanUserDeleteRows="False"
                CanUserSortColumns="True"
                IsReadOnly="False"
                ItemsSource="{Binding Clients}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding ClientId}"
                        Header="ID"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Name, Mode=TwoWay}"
                        Header="Nazwa" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding NIP, Mode=TwoWay}"
                        Header="NIP" />
                    <DataGridTextColumn
                        Width="3*"
                        Binding="{Binding Description, Mode=TwoWay}"
                        Header="Osoba kontaktowa" />
                    <DataGridTextColumn
                        Width="3*"
                        Binding="{Binding Address, Mode=TwoWay}"
                        Header="Adres" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>