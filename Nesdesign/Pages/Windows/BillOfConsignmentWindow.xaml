<Window
    x:Class="Nesdesign.Pages.Windows.BillOfConsignmentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Nesdesign.Pages.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Generuj list przewozowy"
    Width="800"
    Height="600"
    mc:Ignorable="d">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="80" />
            <RowDefinition Height="40" />
            <RowDefinition Height="80" />
            <RowDefinition
                Height="Auto"
                MinHeight="100"
                MaxHeight="400" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="Label" />


            <Style TargetType="TextBox">
                <Setter Property="Background" Value="White" />
                <Setter Property="MinWidth" Value="50" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Background" Value="Red" />
                    </Trigger>
                </Style.Triggers>
            </Style>


        </Grid.Resources>
        <TextBlock
            Padding="10"
            FontSize="20"
            FontWeight="Bold"
            Text="Generuj list przewozowy" />
        <Grid Grid.Row="1" MaxWidth="600">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="Nazwa firmy" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                FontSize="16"
                Text="{Binding CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Label
                Grid.Row="1"
                Grid.Column="0"
                Content="Adres firmy" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                FontSize="16"
                Text="{Binding CompanyAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Label
                Grid.Row="2"
                Grid.Column="0"
                Content="Adresat" />
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                FontSize="16"
                Text="{Binding Person, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />



        </Grid>

        <Grid
            Grid.Row="3"
            Width="Auto"
            MaxWidth="600">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="Numer listu przewozowego:" />

            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="10"
                Text="{Binding BillNr}" />
            <Label
                Grid.Row="1"
                Grid.Column="0"
                Content="Numer zamówienia:" />

            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="10"
                Text="{Binding OrderNumber}" />
        </Grid>


        <DataGrid
            Grid.Row="4"
            MaxWidth="400"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            ItemsSource="{Binding Parts}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" Header="Nazwa / numer">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn MaxWidth="60" Header="Liczba">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
               
            
                <DataGridCheckBoxColumn
                    MaxWidth="60"
                    Binding="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="Wybrane" />
            </DataGrid.Columns>
        </DataGrid>

        <Button
            Grid.Row="5"
            Width="100"
            Margin="0,0,10,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="GeneratePdf_Click"
            Content="Generuj" />
    </Grid>
</Window>
